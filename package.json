{
  "name": "fec-build",
  "private": true,
  "version": "1.0.0",
  "description": "Build pipeline (Tailwind CSS + Mermaid pre-render + Playwright tests) para FEC. NÃO publicado em npm.",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/inema.src.css -o ./assets/css/inema.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/inema.src.css -o ./assets/css/inema.css --watch",
    "build:diagrams": "bash scripts/render-diagrams.sh",
    "build:all": "npm run build:css && npm run build:diagrams",
    "test:visual": "playwright test tests/visual/",
    "test:a11y": "playwright test tests/a11y/"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.4.2",
    "@playwright/test": "1.49.0",
    "@axe-core/playwright": "4.10.0",
    "tailwindcss": "3.4.17",
    "@tailwindcss/typography": "0.5.15",
    "dompurify": "3.2.3",
    "markdown-it": "14.1.0",
    "svgo": "3.3.2",
    "cspell": "8.16.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
