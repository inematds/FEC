{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inematds.github.io/FEC/schemas/quiz.schema.json",
  "title": "FEC Module Quiz",
  "description": "5 questions per module, rendered by build-quiz.py to HTML. Text fields are sanitized via DOMPurify (item 34a).",
  "type": "object",
  "required": ["schema_version", "module_id", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "module_id": { "type": "string", "pattern": "^modulo-[1-6]-[1-3]$" },
    "title": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "type", "question", "options", "correct", "rationale"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^q[1-5]$" },
          "type": { "type": "string", "enum": ["single", "multiple", "true_false"] },
          "question": { "type": "string", "minLength": 1, "maxLength": 500 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-f]$" },
                "text": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          },
          "correct": {
            "oneOf": [
              { "type": "string", "pattern": "^[a-f]$" },
              { "type": "array", "items": { "type": "string", "pattern": "^[a-f]$" }, "minItems": 1 }
            ]
          },
          "rationale": { "type": "string", "minLength": 10 },
          "level": { "type": "string", "enum": ["builder-solo", "eng-produto", "eng-plataforma"] }
        }
      }
    }
  }
}
