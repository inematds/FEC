assets/css/inema.css.map

# Local secrets / credentials — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Per-user fec_sdk state
~/.fec/
.fec.local.json

# OS
*.log
*.tmp

# Claude Code / claudex local tooling state (transcripts redundantes com RELATORIO-CLAUDEX.md)
.claude/

# Dataset caches (download once, don't commit large)
fixtures-external/
*.cache/

# Playwright / Mermaid
test-results/
playwright-report/
.mermaid-cache/

# Release artifacts (built into releases/v<X.Y.Z>/, but binary builds excluded)
releases/v*/dist/
*.whl
*.tar.gz
*.zip
!releases/CHECKSUMS-*.txt
